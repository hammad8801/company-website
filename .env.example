# Use the current supported Graph API version configured for your Meta app.
META_GRAPH_API_VERSION=vXX.X
WHATSAPP_ACCESS_TOKEN=replace_with_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_sender_phone_number_id

# Team member/inbox number that receives the website lead, including country code.
WHATSAPP_LEAD_RECIPIENT=918799010330
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# The team notification template must be approved before production use.
WHATSAPP_LEAD_TEMPLATE_NAME=new_website_lead
WHATSAPP_TEMPLATE_LANGUAGE=en_US
